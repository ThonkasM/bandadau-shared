{
  "name": "bandadau-shared",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint packages",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "contracts:gen": "pnpm --filter @bandada/contracts-ts contracts:gen",
    "i18n:check": "pnpm --filter @bandada/i18n i18n:check"
  },
  "devDependencies": {
    "@bandada/eslint-config": "workspace:*",
    "eslint": "^9.39.5"
  }
}
