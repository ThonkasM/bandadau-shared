    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
