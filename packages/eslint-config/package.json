{
  "name": "@bandada/eslint-config",
  "version": "0.1.0",
  "description": "ESLint flat config presets for Bandada U",
  "license": "UNLICENSED",
  "type": "module",
  "files": ["src"],
  "exports": {
    ".": "./src/base.js",
    "./base": "./src/base.js",
    "./node": "./src/node.js",
    "./react": "./src/react.js",
