{
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms"
      },
      "normal": {
        "$value": "200ms"
      },
      "slow": {
        "$value": "320ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      },
      "emphasized": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "z": {
    "$type": "number",
    "dropdown": {
      "$value": 1000
    },
    "sticky": {
      "$value": 1100
    },
    "modal": {
      "$value": 1300
    },
    "toast": {
      "$value": 1400
    }
  }
}
