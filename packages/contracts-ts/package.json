{
  "name": "@bandada/contracts-ts",
  "version": "0.1.0",
  "description": "TypeScript types generated from bandadau-docs/contracts (OpenAPI, AsyncAPI, GraphQL) plus Problem Details helpers",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./problem": {
      "import": { "types": "./dist/problem.d.ts", "default": "./dist/problem.js" },
      "require": { "types": "./dist/problem.d.cts", "default": "./dist/problem.cjs" }
    },
    "./events": {
      "import": { "types": "./dist/events.d.ts", "default": "./dist/events.js" },
      "require": { "types": "./dist/events.d.cts", "default": "./dist/events.cjs" }
    },
    "./graphql/admin": {
      "import": { "types": "./dist/graphql/admin.d.ts", "default": "./dist/graphql/admin.js" },
      "require": { "types": "./dist/graphql/admin.d.cts", "default": "./dist/graphql/admin.cjs" }
    },
    "./openapi/*": {
      "import": { "types": "./dist/openapi/*.d.ts", "default": "./dist/openapi/*.js" },
      "require": { "types": "./dist/openapi/*.d.cts", "default": "./dist/openapi/*.cjs" }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "contracts:gen": "node scripts/generate.mjs",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bandada/tsconfig": "workspace:*",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@types/node": "^24.19.2",
    "graphql": "^16.14.2",
    "openapi-typescript": "^7.13.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
